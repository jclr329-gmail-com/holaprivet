{
    "name": "holaprivet/curso",
    "type": "project",
    "description": "holaprivet.com - Curso de espanol para rusohablantes",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
